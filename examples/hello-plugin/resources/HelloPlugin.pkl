module ba.sake.deder.examples.plugins.hello

//import "../../../config/DederPlugins.pkl" as P
import "https://sake92.github.io/deder/config/early-access/DederPlugins.pkl" as P

class HelloPlugin extends P.DederPlugin {
  id = "hello"
  deps {
    "ba.sake::deder-hello-plugin:0.7.8-SNAPSHOT"
  }
  config: HelloPluginConfig = new {}
}

class HelloPluginConfig {
  greeting: String = "Hello, Deder!"
}

// only used for parsing on the plugin side!
config: HelloPluginConfig = new {}

amends ".../config/DederProject.pkl"

modules {
  new ScalaModule {
    id = "hello-plugin2"
    root = "."
    scalaVersion = "3.7.4"
    resources { "resources" }
    deps {
      "ba.sake::deder-plugin-api:0.16.3-SNAPSHOT"
      "com.lihaoyi::os-lib:0.11.0"
    }
    pomSettings {
      groupId = "ba.sake"
      artifactId = "deder-hello-plugin2"
      version = "0.0.1-SNAPSHOT"
      name = "Deder Hello Plugin"
      description = "Example Deder plugin that adds a 'hello2' task"
    }
    publish = true
  }
}

typelevelScala213Dev: P.ScalaModule = mkBaseMain("2.13", "dev")
typelevelScala213Ci: P.ScalaModule = mkBaseMain("2.13", "ci")
typelevelScala213: P.ScalaModule =
  if (read?("env:CI") != null) typelevelScala213Ci else typelevelScala213Dev

typelevelScala213TestDev: P.ScalaTestModule = mkBaseTest("2.13", "dev")
typelevelScala213TestCi: P.ScalaTestModule = mkBaseTest("2.13", "ci")
typelevelScala213Test: P.ScalaTestModule =
  if (read?("env:CI") != null) typelevelScala213TestCi else typelevelScala213TestDev

typelevelScala213JsDev: P.ScalaJsModule = mkBaseJs("2.13", "dev")
typelevelScala213JsCi: P.ScalaJsModule = mkBaseJs("2.13", "ci")
typelevelScala213Js: P.ScalaJsModule =
  if (read?("env:CI") != null) typelevelScala213JsCi else typelevelScala213JsDev

typelevelScala213JsTestDev: P.ScalaJsTestModule = mkBaseJsTest("2.13", "dev")
typelevelScala213JsTestCi: P.ScalaJsTestModule = mkBaseJsTest("2.13", "ci")
typelevelScala213JsTest: P.ScalaJsTestModule =
  if (read?("env:CI") != null) typelevelScala213JsTestCi else typelevelScala213JsTestDev

typelevelScala213NativeDev: P.ScalaNativeModule = mkBaseNative("2.13", "dev")
typelevelScala213NativeCi: P.ScalaNativeModule = mkBaseNative("2.13", "ci")
typelevelScala213Native: P.ScalaNativeModule =
  if (read?("env:CI") != null) typelevelScala213NativeCi else typelevelScala213NativeDev

typelevelScala213NativeTestDev: P.ScalaNativeTestModule = mkBaseNativeTest("2.13", "dev")
typelevelScala213NativeTestCi: P.ScalaNativeTestModule = mkBaseNativeTest("2.13", "ci")
typelevelScala213NativeTest: P.ScalaNativeTestModule =
  if (read?("env:CI") != null) typelevelScala213NativeTestCi else typelevelScala213NativeTestDev

// --- Scala 2.12 exports ---

typelevelScala212Dev: P.ScalaModule = mkBaseMain("2.12", "dev")
typelevelScala212Ci: P.ScalaModule = mkBaseMain("2.12", "ci")
typelevelScala212: P.ScalaModule =
  if (read?("env:CI") != null) typelevelScala212Ci else typelevelScala212Dev

typelevelScala212TestDev: P.ScalaTestModule = mkBaseTest("2.12", "dev")
typelevelScala212TestCi: P.ScalaTestModule = mkBaseTest("2.12", "ci")
typelevelScala212Test: P.ScalaTestModule =
  if (read?("env:CI") != null) typelevelScala212TestCi else typelevelScala212TestDev

typelevelScala212JsDev: P.ScalaJsModule = mkBaseJs("2.12", "dev")
typelevelScala212JsCi: P.ScalaJsModule = mkBaseJs("2.12", "ci")
typelevelScala212Js: P.ScalaJsModule =
  if (read?("env:CI") != null) typelevelScala212JsCi else typelevelScala212JsDev

typelevelScala212JsTestDev: P.ScalaJsTestModule = mkBaseJsTest("2.12", "dev")
typelevelScala212JsTestCi: P.ScalaJsTestModule = mkBaseJsTest("2.12", "ci")

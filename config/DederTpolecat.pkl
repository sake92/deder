/// sbt-tpolecat scalac options as reusable ScalaModule templates.
/// Source: https://github.com/typelevel/sbt-tpolecat
/// Option lists transcribed from org.typelevel.scalacoptions.ScalacOptions (tpolecat 0.5.x).
///
/// Modes: Dev (default, no fatal warnings), Ci (with -Xfatal-warnings / -Werror).
/// Mode auto-selected via $CI env var.

tpolecatOpts2_12: Listing<String> = new {
  "-encoding:utf8"
  "-deprecation"
  "-feature"
  "-unchecked"
  "-language:existentials"
  "-language:experimental.macros"
  "-language:higherKinds"
  "-language:implicitConversions"
  "-Xlint:adapted-args"
  "-Xlint:by-name-right-associative"
  "-Xlint:constant"
  "-Xlint:delayedinit-select"
  "-Xlint:deprecation"
  "-Xlint:doc-detached"
  "-Xlint:inaccessible"
  "-Xlint:infer-any"
  "-Xlint:missing-interpolator"
  "-Xlint:nullary-override"
  "-Xlint:nullary-unit"
  "-Xlint:option-implicit"
  "-Xlint:package-object-classes"
  "-Xlint:poly-implicit-overload"
  "-Xlint:private-shadow"
  "-Xlint:stars-align"
  "-Xlint:type-parameter-shadow"
  "-Xlint:unsound-match"
  "-Yno-adapted-args"
  "-Ypartial-unification"
  "-Ywarn-dead-code"
  "-Ywarn-extra-implicit"
  "-Ywarn-nullary-override"
  "-Ywarn-nullary-unit"
  "-Ywarn-numeric-widen"
  "-Ywarn-value-discard"
  "-Ywarn-unused:implicits"
  "-Ywarn-unused:imports"
  "-Ywarn-unused:locals"
  "-Ywarn-unused:params"
  "-Ywarn-unused:patvars"
  "-Ywarn-unused:privates"
  "-Ywarn-unused:nowarn"
}

tpolecatOpts2_13: Listing<String> = new {
  "-encoding:utf8"
  "-feature"
  "-unchecked"
  "-language:existentials"
  "-language:experimental.macros"
  "-language:higherKinds"
  "-language:implicitConversions"
  "-Xlint:adapted-args"
  "-Xlint:constant"
  "-Xlint:delayedinit-select"
  "-Xlint:deprecation"
  "-Xlint:doc-detached"
  "-Xlint:implicit-recursion"
  "-Xlint:implicit-not-found"
  "-Xlint:inaccessible"
  "-Xlint:infer-any"
  "-Xlint:missing-interpolator"
  "-Xlint:nullary-unit"
  "-Xlint:option-implicit"
  "-Xlint:package-object-classes"
  "-Xlint:poly-implicit-overload"
  "-Xlint:private-shadow"
  "-Xlint:stars-align"
  "-Xlint:strict-unsealed-patmat"
  "-Xlint:type-parameter-shadow"
  "-Xlint:-byname-implicit"
  "-Wdead-code"
  "-Wextra-implicit"
  "-Wnumeric-widen"
  "-Wvalue-discard"
  "-Wnonunit-statement"
  "-Wunused:nowarn"
  "-Wunused:implicits"
  "-Wunused:explicits"
  "-Wunused:imports"
  "-Wunused:locals"
  "-Wunused:params"
  "-Wunused:patvars"
  "-Wunused:privates"
}

tpolecatOpts3: Listing<String> = new {
  "-encoding:utf8"
  "-deprecation"
  "-feature"
  "-unchecked"
  "-language:experimental.macros"
  "-language:higherKinds"
  "-language:implicitConversions"
  "-Ykind-projector"
  "-Wvalue-discard"
  "-Wunused:implicits"
  "-Wunused:explicits"
  "-Wunused:imports"
  "-Wunused:locals"
  "-Wunused:params"
  "-Wunused:privates"
}

function mkScalacOptions(version: String, mode: String): Listing<String> =
  let (opts =
    if (version == "2.12") tpolecatOpts2_12
    else if (version == "2.13") tpolecatOpts2_13
    else tpolecatOpts3
  )
  let (fatalFlag = if (version == "3") "-Werror" else "-Xfatal-warnings")
    if (mode == "ci") (opts.toList() + fatalFlag).toListing()
    else opts

function mkBaseMain(version: String, mode: String): ScalaModule = new {
  scalacOptions = mkScalacOptions(version, mode)
  compileOrder = "java-then-scala"
}

function mkBaseTest(version: String, mode: String): ScalaTestModule =
  (mkBaseMain(version, mode)).asTest()

function mkBaseJs(version: String, mode: String): ScalaJsModule =
  ((mkBaseMain(version, mode)).asJs()) {
    scalaJsVersion = "1.18.2"
  }

function mkBaseJsTest(version: String, mode: String): ScalaJsTestModule =
  (mkBaseJs(version, mode)).asTest()

function mkBaseNative(version: String, mode: String): ScalaNativeModule =
  ((mkBaseMain(version, mode)).asNative()) {
    scalaNativeVersion = "0.5.7"
  }

function mkBaseNativeTest(version: String, mode: String): ScalaNativeTestModule =
  (mkBaseNative(version, mode)).asTest()

// --- Scala 3 exports ---

tpolecatScala3Dev = mkBaseMain("3", "dev")
tpolecatScala3Ci  = mkBaseMain("3", "ci")
tpolecatScala3    = if (read?("env:CI") != null) tpolecatScala3Ci else tpolecatScala3Dev

tpolecatScala3TestDev = mkBaseTest("3", "dev")
tpolecatScala3TestCi  = mkBaseTest("3", "ci")
tpolecatScala3Test    = if (read?("env:CI") != null) tpolecatScala3TestCi else tpolecatScala3TestDev

tpolecatScala3JsDev = mkBaseJs("3", "dev")
tpolecatScala3JsCi  = mkBaseJs("3", "ci")
tpolecatScala3Js    = if (read?("env:CI") != null) tpolecatScala3JsCi else tpolecatScala3JsDev

tpolecatScala3JsTestDev = mkBaseJsTest("3", "dev")
tpolecatScala3JsTestCi  = mkBaseJsTest("3", "ci")
tpolecatScala3JsTest    = if (read?("env:CI") != null) tpolecatScala3JsTestCi else tpolecatScala3JsTestDev

tpolecatScala3NativeDev = mkBaseNative("3", "dev")
tpolecatScala3NativeCi  = mkBaseNative("3", "ci")
tpolecatScala3Native    = if (read?("env:CI") != null) tpolecatScala3NativeCi else tpolecatScala3NativeDev

tpolecatScala3NativeTestDev = mkBaseNativeTest("3", "dev")
tpolecatScala3NativeTestCi  = mkBaseNativeTest("3", "ci")
tpolecatScala3NativeTest    = if (read?("env:CI") != null) tpolecatScala3NativeTestCi else tpolecatScala3NativeTestDev

// --- Scala 2.13 exports ---

tpolecatScala213Dev = mkBaseMain("2.13", "dev")
tpolecatScala213Ci  = mkBaseMain("2.13", "ci")
tpolecatScala213    = if (read?("env:CI") != null) tpolecatScala213Ci else tpolecatScala213Dev

tpolecatScala213TestDev = mkBaseTest("2.13", "dev")
tpolecatScala213TestCi  = mkBaseTest("2.13", "ci")
tpolecatScala213Test    = if (read?("env:CI") != null) tpolecatScala213TestCi else tpolecatScala213TestDev

tpolecatScala213JsDev = mkBaseJs("2.13", "dev")
tpolecatScala213JsCi  = mkBaseJs("2.13", "ci")
tpolecatScala213Js    = if (read?("env:CI") != null) tpolecatScala213JsCi else tpolecatScala213JsDev

tpolecatScala213JsTestDev = mkBaseJsTest("2.13", "dev")
tpolecatScala213JsTestCi  = mkBaseJsTest("2.13", "ci")
tpolecatScala213JsTest    = if (read?("env:CI") != null) tpolecatScala213JsTestCi else tpolecatScala213JsTestDev

tpolecatScala213NativeDev = mkBaseNative("2.13", "dev")
tpolecatScala213NativeCi  = mkBaseNative("2.13", "ci")
tpolecatScala213Native    = if (read?("env:CI") != null) tpolecatScala213NativeCi else tpolecatScala213NativeDev

tpolecatScala213NativeTestDev = mkBaseNativeTest("2.13", "dev")
tpolecatScala213NativeTestCi  = mkBaseNativeTest("2.13", "ci")
tpolecatScala213NativeTest    = if (read?("env:CI") != null) tpolecatScala213NativeTestCi else tpolecatScala213NativeTestDev

// --- Scala 2.12 exports ---

tpolecatScala212Dev = mkBaseMain("2.12", "dev")
tpolecatScala212Ci  = mkBaseMain("2.12", "ci")
tpolecatScala212    = if (read?("env:CI") != null) tpolecatScala212Ci else tpolecatScala212Dev

tpolecatScala212TestDev = mkBaseTest("2.12", "dev")
tpolecatScala212TestCi  = mkBaseTest("2.12", "ci")
tpolecatScala212Test    = if (read?("env:CI") != null) tpolecatScala212TestCi else tpolecatScala212TestDev

tpolecatScala212JsDev = mkBaseJs("2.12", "dev")
tpolecatScala212JsCi  = mkBaseJs("2.12", "ci")
tpolecatScala212Js    = if (read?("env:CI") != null) tpolecatScala212JsCi else tpolecatScala212JsDev

tpolecatScala212JsTestDev = mkBaseJsTest("2.12", "dev")
tpolecatScala212JsTestCi  = mkBaseJsTest("2.12", "ci")
tpolecatScala212JsTest    = if (read?("env:CI") != null) tpolecatScala212JsTestCi else tpolecatScala212JsTestDev

tpolecatScala212NativeDev = mkBaseNative("2.12", "dev")
tpolecatScala212NativeCi  = mkBaseNative("2.12", "ci")
tpolecatScala212Native    = if (read?("env:CI") != null) tpolecatScala212NativeCi else tpolecatScala212NativeDev

tpolecatScala212NativeTestDev = mkBaseNativeTest("2.12", "dev")
tpolecatScala212NativeTestCi  = mkBaseNativeTest("2.12", "ci")
tpolecatScala212NativeTest    = if (read?("env:CI") != null) tpolecatScala212NativeTestCi else tpolecatScala212NativeTestDev

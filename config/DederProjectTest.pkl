amends "pkl:test"

import "pkl:test" as test
import "DederProject.pkl"
import "DederInternals.pkl" as I

facts {
  // validScalaVersion tests
  ["validScalaVersion accepts 3-part"] {
    DederProject.validScalaVersion("3.7.4") == true
  }

  ["validScalaVersion accepts 3-part with suffix"] {
    DederProject.validScalaVersion("2.13.18+3") == true
  }

  ["validScalaVersion rejects 2-part"] {
    test.catchOrNull(() -> DederProject.validScalaVersion("2.13")) != null
  }

  ["validScalaVersion rejects 1-part"] {
    test.catchOrNull(() -> DederProject.validScalaVersion("21")) != null
  }

  ["validScalaVersion rejects empty"] {
    test.catchOrNull(() -> DederProject.validScalaVersion("")) != null
  }

  // Test version prefix extraction indirectly via scalaModules
  ["scalaModules default layout"] {
    local mod = new DederProject.ScalaModule { scalaVersion = "3.7.4"; id = "x" }
    local result = DederProject.scalaModules(mod, mod.asTest(), "mylib", "default", null)
    result.main.sources.toList().distinct == List("src", "src-3", "src-3.7", "src-3.7.4")
  }

  ["scalaModules - Coursier suffix stripped"] {
    local mod = new DederProject.ScalaModule { scalaVersion = "2.13.18+3"; id = "x" }
    local result = DederProject.scalaModules(mod, mod.asTest(), "mylib", "default", null)
    result.main.sources.toList().distinct == List("src", "src-2", "src-2.13", "src-2.13.18")
  }

  ["scalaModules maven layout"] {
    local mod = new DederProject.ScalaModule { scalaVersion = "3.7.4"; id = "x" }
    local result = DederProject.scalaModules(mod, mod.asTest(), "mylib", "maven", null)
    result.main.sources.toList().distinct == List("src/main/scala", "src/main/java", "src/main/scala-3", "src/main/scala-3.7", "src/main/scala-3.7.4", "src")
  }

  ["scalaModules maven layout - test root shared"] {
    local mod = new DederProject.ScalaModule { scalaVersion = "3.7.4"; id = "x" }
    local result = DederProject.scalaModules(mod, mod.asTest(), "mylib", "maven", null)
    result.test.root == "mylib"
  }

  // Layout: javaModules (no version auto-detection)
  ["javaModules maven layout"] {
    local javaMod = new DederProject.JavaModule { id = "x" }
    local result = DederProject.javaModules(javaMod, javaMod.asTest(), "mylib", "maven", null)
    result.main.sources.toList().distinct == List("src/main/java", "src")
    result.main.resources.toList().distinct == List("src/main/resources", "resources")
    result.test.root == "mylib"
    result.test.sources.toList().distinct == List("src/test/java", "src")
  }

  ["javaModules default layout"] {
    local javaMod = new DederProject.JavaModule { id = "x" }
    local result = DederProject.javaModules(javaMod, javaMod.asTest(), "mylib", "default", null)
    result.main.sources.toList().distinct == List("src")
    result.main.resources.toList().distinct == List("resources")
    result.test.root == "mylib/test"
  }

  // Layout: crossModules (version dirs + platform dirs)
  ["crossModules default layout"] {
    local scalaMod = new DederProject.ScalaModule { scalaVersion = "3.7.4"; id = "x" }
    local jsMod = (scalaMod.asJs()) { scalaJsVersion = "1.18.2" }
    local nativeMod = (scalaMod.asNative()) { scalaNativeVersion = "0.5.10" }
    local result = DederProject.crossModules(scalaMod, scalaMod.asTest(), jsMod, jsMod.asTest(), nativeMod, nativeMod.asTest(), "mylib", "default", null)
    result.jvm.sources.toList().distinct == List("src", "src-3", "src-3.7", "src-3.7.4", "src-jvm")
    result.jvm.root == "mylib"
    result.jvm_test.root == "mylib/test"
  }

  ["crossModules maven layout"] {
    local scalaMod = new DederProject.ScalaModule { scalaVersion = "3.7.4"; id = "x" }
    local jsMod = (scalaMod.asJs()) { scalaJsVersion = "1.18.2" }
    local nativeMod = (scalaMod.asNative()) { scalaNativeVersion = "0.5.10" }
    local result = DederProject.crossModules(scalaMod, scalaMod.asTest(), jsMod, jsMod.asTest(), nativeMod, nativeMod.asTest(), "mylib", "maven", null)
    result.jvm.sources.toList().distinct == List("src/main/scala", "src/main/java", "src/main/scala-3", "src/main/scala-3.7", "src/main/scala-3.7.4", "src/main/scala-jvm", "src")
    result.jvm.resources.toList().distinct == List("src/main/resources", "resources")
    result.jvm.root == "mylib"
    result.jvm_test.root == "mylib"
  }

  // Template sources/resources propagation
  ["javaModules with custom template sources"] {
    local javaMod = new DederProject.JavaModule { id = "x"; sources { "gen" } }
    local result = DederProject.javaModules(javaMod, javaMod.asTest(), "mylib", "maven", null)
    result.main.sources.toList().contains("gen") == true
    && result.test.sources.toList().contains("gen") == true
  }

  ["javaModules with custom template resources"] {
    local javaMod = new DederProject.JavaModule { id = "x"; resources { "conf" } }
    local result = DederProject.javaModules(javaMod, javaMod.asTest(), "mylib", "maven", null)
    result.main.resources.toList().contains("conf") == true
    && result.test.resources.toList().contains("conf") == true
  }

  ["scalaModules with custom template sources and resources"] {
    local mod = new DederProject.ScalaModule { scalaVersion = "3.7.4"; id = "x"; sources { "generated" }; resources { "data" } }
    local result = DederProject.scalaModules(mod, mod.asTest(), "mylib", "default", null)
    result.main.sources.toList().contains("generated") == true
    && result.main.resources.toList().contains("data") == true
    && result.test.sources.toList().contains("generated") == true
    && result.test.resources.toList().contains("data") == true
  }

  ["scalaJsModules with custom template sources and resources"] {
    local mod = new DederProject.ScalaJsModule { scalaVersion = "3.7.4"; scalaJsVersion = "1.18.2"; id = "x"; sources { "js-src" }; resources { "js-res" } }
    local result = DederProject.scalaJsModules(mod, mod.asTest(), "mylib", "default", null)
    result.main.sources.toList().contains("js-src") == true
    && result.main.resources.toList().contains("js-res") == true
    && result.test.sources.toList().contains("js-src") == true
    && result.test.resources.toList().contains("js-res") == true
  }

  ["scalaNativeModules with custom template sources and resources"] {
    local mod = new DederProject.ScalaNativeModule { scalaVersion = "3.7.4"; scalaNativeVersion = "0.5.10"; id = "x"; sources { "native-src" }; resources { "native-res" } }
    local result = DederProject.scalaNativeModules(mod, mod.asTest(), "mylib", "default", null)
    result.main.sources.toList().contains("native-src") == true
    && result.main.resources.toList().contains("native-res") == true
    && result.test.sources.toList().contains("native-src") == true
    && result.test.resources.toList().contains("native-res") == true
  }

  ["crossModules with custom template sources and resources"] {
    local scalaMod = new DederProject.ScalaModule { scalaVersion = "3.7.4"; id = "x"; sources { "shared-src" }; resources { "shared-res" } }
    local jsMod = (scalaMod.asJs()) { scalaJsVersion = "1.18.2" }
    local nativeMod = (scalaMod.asNative()) { scalaNativeVersion = "0.5.10" }
    local result = DederProject.crossModules(scalaMod, scalaMod.asTest(), jsMod, jsMod.asTest(), nativeMod, nativeMod.asTest(), "mylib", "default", null)
    result.jvm.sources.toList().contains("shared-src") == true
    && result.jvm.resources.toList().contains("shared-res") == true
  }

  // sbt version prefix tests
  ["sbtVersionPrefixes 2.13.18"] {
    local result = I.sbtVersionPrefixes("2.13.18")
    result == List("2", "2.13", "2.13.18", "2.13+")
  }

  ["sbtVersionPrefixes 3.3.4"] {
    local result = I.sbtVersionPrefixes("3.3.4")
    result == List("3", "3.3", "3.3.4", "3.3+", "2.13+")
  }

  ["sbtVersionPrefixes 2.12.20"] {
    local result = I.sbtVersionPrefixes("2.12.20")
    result == List("2", "2.12", "2.12.20", "2.12+")
  }

  ["sbtVersionPrefixes with Coursier suffix"] {
    local result = I.sbtVersionPrefixes("2.13.18+3")
    result == List("2", "2.13", "2.13.18", "2.13+")
  }

  // sbt layout tests
  ["scalaModules sbt layout 2.13.18"] {
    local mod = new DederProject.ScalaModule { scalaVersion = "2.13.18"; id = "x" }
    local result = DederProject.scalaModules(mod, mod.asTest(), "mylib", "sbt", null)
    local srcs = result.main.sources.toList()
    srcs.contains("src/main/scala") == true
    && srcs.contains("src/main/scala-2.13+") == true
    && srcs.contains("src/main/scala-2") == true
  }

  ["scalaModules sbt layout 3.3.4 includes 2.13+"] {
    local mod = new DederProject.ScalaModule { scalaVersion = "3.3.4"; id = "x" }
    local result = DederProject.scalaModules(mod, mod.asTest(), "mylib", "sbt", null)
    local srcs = result.main.sources.toList()
    srcs.contains("src/main/scala") == true
    && srcs.contains("src/main/scala-3.3+") == true
    && srcs.contains("src/main/scala-2.13+") == true
  }

  // sbt-cross-full layout
  ["crossModules sbt-cross-full 2.13.18 shared dirs"] {
    local scalaMod = new DederProject.ScalaModule { scalaVersion = "2.13.18"; id = "x" }
    local jsMod = (scalaMod.asJs()) { scalaJsVersion = "1.18.2" }
    local nativeMod = (scalaMod.asNative()) { scalaNativeVersion = "0.5.10" }
    local result = DederProject.crossModules(scalaMod, scalaMod.asTest(), jsMod, jsMod.asTest(), nativeMod, nativeMod.asTest(), "mylib", "sbt-cross-full", null)
    local jvmSrcs = result.jvm.sources.toList()
    jvmSrcs.contains("shared/src/main/scala") == true
    && jvmSrcs.contains("jvm/src/main/scala") == true
    && result.jvm.resources.toList().contains("shared/src/main/resources") == true
  }

  // sbt-cross-pure layout  
  ["crossModules sbt-cross-pure 3.3.4 shared base"] {
    local scalaMod = new DederProject.ScalaModule { scalaVersion = "3.3.4"; id = "x" }
    local jsMod = (scalaMod.asJs()) { scalaJsVersion = "1.18.2" }
    local nativeMod = (scalaMod.asNative()) { scalaNativeVersion = "0.5.10" }
    local result = DederProject.crossModules(scalaMod, scalaMod.asTest(), jsMod, jsMod.asTest(), nativeMod, nativeMod.asTest(), "mylib", "sbt-cross-pure", null)
    local jvmSrcs = result.jvm.sources.toList()
    jvmSrcs.contains("src/main/scala") == true
    && jvmSrcs.contains(".jvm/src/main/scala") == true
    && jvmSrcs.contains("src/main/scala-2.13+") == true
  }

  // sbt-cross-dummy layout
  ["crossModules sbt-cross-dummy no shared"] {
    local scalaMod = new DederProject.ScalaModule { scalaVersion = "2.13.18"; id = "x" }
    local jsMod = (scalaMod.asJs()) { scalaJsVersion = "1.18.2" }
    local nativeMod = (scalaMod.asNative()) { scalaNativeVersion = "0.5.10" }
    local result = DederProject.crossModules(scalaMod, scalaMod.asTest(), jsMod, jsMod.asTest(), nativeMod, nativeMod.asTest(), "mylib", "sbt-cross-dummy", null)
    local jvmSrcs = result.jvm.sources.toList()
    jvmSrcs.contains("jvm/src/main/scala") == true
    && jvmSrcs.contains("shared/src/main/scala") == false
    && jvmSrcs.contains("src/main/scala") == false
  }

  // id override tests
  ["scalaModules id override"] {
    local mod = new DederProject.ScalaModule { scalaVersion = "3.7.4"; id = "x" }
    local result = DederProject.scalaModules(mod, mod.asTest(), ".", "default", "myproject")
    result.main.id == "myproject"
    && result.test.id == "myproject-test"
  }

  ["scalaModules explicit test id override"] {
    local mod = new DederProject.ScalaModule { scalaVersion = "3.7.4"; id = "x" }
    local result = DederProject.scalaModulesWithTestId(
      mod,
      mod.asTest(),
      ".",
      "default",
      "myproject-jvm-3.7.4",
      "myproject-jvm-test-3.7.4",
    )
    result.main.id == "myproject-jvm-3.7.4"
    && result.test.id == "myproject-jvm-test-3.7.4"
  }

  ["scalaModules id null uses root"] {
    local mod = new DederProject.ScalaModule { scalaVersion = "3.7.4"; id = "x" }
    local result = DederProject.scalaModules(mod, mod.asTest(), "sub/dir", "default", null)
    result.main.id == "sub-dir"
    && result.test.id == "sub-dir-test"
  }

  ["crossModules id override"] {
    local scalaMod = new DederProject.ScalaModule { scalaVersion = "3.7.4"; id = "x" }
    local jsMod = (scalaMod.asJs()) { scalaJsVersion = "1.18.2" }
    local nativeMod = (scalaMod.asNative()) { scalaNativeVersion = "0.5.10" }
    local result = DederProject.crossModules(scalaMod, scalaMod.asTest(), jsMod, jsMod.asTest(), nativeMod, nativeMod.asTest(), ".", "default", "myapp")
    result.jvm.id == "myapp-jvm-3.7.4"
    && result.jvm_test.id == "myapp-jvm-test-3.7.4"
    && result.js.id == "myapp-js-3.7.4"
    && result.js_test.id == "myapp-js-test-3.7.4"
    && result.native.id == "myapp-native-3.7.4"
    && result.native_test.id == "myapp-native-test-3.7.4"
  }

  ["crossModules id null uses root"] {
    local scalaMod = new DederProject.ScalaModule { scalaVersion = "3.7.4"; id = "x" }
    local jsMod = (scalaMod.asJs()) { scalaJsVersion = "1.18.2" }
    local nativeMod = (scalaMod.asNative()) { scalaNativeVersion = "0.5.10" }
    local result = DederProject.crossModules(scalaMod, scalaMod.asTest(), jsMod, jsMod.asTest(), nativeMod, nativeMod.asTest(), "sub/dir", "default", null)
    result.jvm.id == "sub-dir-jvm-3.7.4"
    && result.jvm_test.id == "sub-dir-jvm-test-3.7.4"
    && result.js.id == "sub-dir-js-3.7.4"
    && result.js_test.id == "sub-dir-js-test-3.7.4"
    && result.native.id == "sub-dir-native-3.7.4"
    && result.native_test.id == "sub-dir-native-test-3.7.4"
  }
}

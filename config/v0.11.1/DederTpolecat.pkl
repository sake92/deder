/// Returns the auto-select base template for a given Scala version string.
/// "3.7.4" -> tpolecatScala3, "2.13.18" -> tpolecatScala213, "2.12.20" -> tpolecatScala212
function forVersion(sv: String): P.ScalaModule =
  if (sv.startsWith("3"))
    tpolecatScala3
  else if (sv.startsWith("2.13"))
    tpolecatScala213
  else
    tpolecatScala212

/// Returns the auto-select test template for a given Scala version string.
function testForVersion(sv: String): P.ScalaTestModule =
  (if (sv.startsWith("3"))
    tpolecatScala3Test
  else if (sv.startsWith("2.13"))
    tpolecatScala213Test
  else
    tpolecatScala212Test) { scalaVersion = sv }

/// Returns the auto-select Scala.js template for a given Scala version string.
function jsForVersion(sv: String, jsVersion: String): P.ScalaJsModule =
  (if (sv.startsWith("3"))
    tpolecatScala3Js
  else if (sv.startsWith("2.13"))
    tpolecatScala213Js
  else
    tpolecatScala212Js) {
    scalaVersion = sv
    scalaJsVersion = jsVersion
  }

/// Returns the auto-select Scala.js test template for a given Scala version string.
function jsTestForVersion(sv: String, jsVersion: String): P.ScalaJsTestModule =
  (if (sv.startsWith("3"))
    tpolecatScala3JsTest
  else if (sv.startsWith("2.13"))
    tpolecatScala213JsTest
  else
    tpolecatScala212JsTest) {
    scalaVersion = sv
    scalaJsVersion = jsVersion
  }

/// Returns the auto-select Scala Native template for a given Scala version string.
function nativeForVersion(sv: String, nativeVersion: String): P.ScalaNativeModule =
  (if (sv.startsWith("3"))
    tpolecatScala3Native
  else if (sv.startsWith("2.13"))
    tpolecatScala213Native
  else
    tpolecatScala212Native) {
    scalaVersion = sv
    scalaNativeVersion = nativeVersion
  }

/// Returns the auto-select Scala Native test template for a given Scala version string.
function nativeTestForVersion(sv: String, nativeVersion: String): P.ScalaNativeTestModule =
  (if (sv.startsWith("3"))
    tpolecatScala3NativeTest
  else if (sv.startsWith("2.13"))
    tpolecatScala213NativeTest
  else
    tpolecatScala212NativeTest) {
    scalaVersion = sv
    scalaNativeVersion = nativeVersion
  }

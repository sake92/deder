module ba.sake.deder.config.DederTpolecat

import "DederProject.pkl" as P

/// sbt-tpolecat scalac options as reusable ScalaModule templates.
/// Source: https://github.com/typelevel/sbt-tpolecat
/// Option lists transcribed from org.typelevel.scalacoptions.ScalacOptions (tpolecat 0.5.x).
///
/// Modes: Dev (default, no fatal warnings), Ci (with -Xfatal-warnings / -Werror).
/// Mode auto-selected via $CI env var.
hidden tpolecatScalacOptions2_12: Listing<String> = new {
  "-encoding"
  "utf8"
  "-deprecation"
  "-feature"
  "-unchecked"
  "-language:existentials"
  "-language:experimental.macros"
  "-language:higherKinds"
  "-language:implicitConversions"
  "-Xlint:adapted-args"
  "-Xlint:by-name-right-associative"
  "-Xlint:constant"
  "-Xlint:delayedinit-select"
  "-Xlint:deprecation"
  "-Xlint:doc-detached"
  "-Xlint:inaccessible"
  "-Xlint:infer-any"
  "-Xlint:missing-interpolator"
  "-Xlint:nullary-override"
  "-Xlint:nullary-unit"
  "-Xlint:option-implicit"
  "-Xlint:package-object-classes"
  "-Xlint:poly-implicit-overload"
  "-Xlint:private-shadow"
  "-Xlint:stars-align"
  "-Xlint:type-parameter-shadow"
  "-Xlint:unsound-match"
  "-Yno-adapted-args"
  "-Ypartial-unification"
  "-Ywarn-dead-code"
  "-Ywarn-extra-implicit"
  "-Ywarn-nullary-override"
  "-Ywarn-nullary-unit"
  "-Ywarn-numeric-widen"
  "-Ywarn-value-discard"
  "-Ywarn-unused:implicits"
  "-Ywarn-unused:imports"
  "-Ywarn-unused:locals"
  "-Ywarn-unused:params"
  "-Ywarn-unused:patvars"
  "-Ywarn-unused:privates"
  "-Ywarn-unused:nowarn"
}

hidden tpolecatScalacOptions2_13: Listing<String> = new {
  "-encoding"
  "utf8"
  "-feature"
  "-unchecked"
  "-language:existentials"
  "-language:experimental.macros"
  "-language:higherKinds"
  "-language:implicitConversions"
  "-Xlint:adapted-args"
  "-Xlint:constant"
  "-Xlint:delayedinit-select"
  "-Xlint:deprecation"
  "-Xlint:doc-detached"
  "-Xlint:implicit-recursion"
  "-Xlint:implicit-not-found"
  "-Xlint:inaccessible"
  "-Xlint:infer-any"
  "-Xlint:missing-interpolator"
  "-Xlint:nullary-unit"
  "-Xlint:option-implicit"
  "-Xlint:package-object-classes"
  "-Xlint:poly-implicit-overload"
  "-Xlint:private-shadow"
  "-Xlint:stars-align"
  "-Xlint:strict-unsealed-patmat"
  "-Xlint:type-parameter-shadow"
  "-Xlint:-byname-implicit"
  "-Wdead-code"
  "-Wextra-implicit"
  "-Wnumeric-widen"
  "-Wvalue-discard"
  "-Wnonunit-statement"
  "-Wunused:nowarn"
  "-Wunused:implicits"
  "-Wunused:explicits"
  "-Wunused:imports"
  "-Wunused:locals"
  "-Wunused:params"
  "-Wunused:patvars"
  "-Wunused:privates"
}

hidden tpolecatScalacOptions3: Listing<String> = new {
  "-encoding"
  "utf8"
  "-deprecation"
  "-feature"
  "-unchecked"
  "-language:experimental.macros"
  "-language:implicitConversions"
  "-Xkind-projector"
  "-Wvalue-discard"
  "-Wnonunit-statement"
  "-Wunused:implicits"
  "-Wunused:explicits"
  "-Wunused:imports"
  "-Wunused:locals"
  "-Wunused:params"
  "-Wunused:privates"
}

local function mkScalacOptions(version: P.ScalaBinaryVersion, mode: String): Listing<String> =
  let (
    opts =
      if (version == "2.12")
        tpolecatScalacOptions2_12
      else if (version == "2.13")
        tpolecatScalacOptions2_13
      else
        tpolecatScalacOptions3
  )
  let (
    fatalFlag =
      if (version == "3")
        "-Werror"
      else if (version == "2.13")
        "-Werror"
      else
        "-Xfatal-warnings"
  )
    if (mode == "ci")
      (opts.toList().add(fatalFlag)).toListing()
    else
      opts

local function mkBaseMain(version: P.ScalaBinaryVersion, mode: String): P.ScalaModule = new {
  id = "dummy-tpolecat-base"
  // dummy scalaVersion just so we get a proper ScalaModule type
  scalaVersion = if (version == "3") "3.0.0" else if (version == "2.13") "2.13.0" else "2.12.0"
  scalacOptions = mkScalacOptions(version, mode)
  compileOrder = "java-then-scala"
}

local function mkBaseTest(version: P.ScalaBinaryVersion, mode: String): P.ScalaTestModule =
  (mkBaseMain(version, mode)).asTest()

local function mkBaseJs(version: P.ScalaBinaryVersion, mode: String): P.ScalaJsModule = (
  (mkBaseMain(version, mode)).asJs()
) {
  scalaJsVersion = "1.18.2"
}

local function mkBaseJsTest(version: P.ScalaBinaryVersion, mode: String): P.ScalaJsTestModule =
  (mkBaseJs(version, mode)).asTest()

local function mkBaseNative(version: P.ScalaBinaryVersion, mode: String): P.ScalaNativeModule = (
  (mkBaseMain(version, mode)).asNative()
) {
  scalaNativeVersion = "0.5.7"
}

local function mkBaseNativeTest(
  version: P.ScalaBinaryVersion,
  mode: String,
): P.ScalaNativeTestModule = (mkBaseNative(version, mode)).asTest()

// --- Scala 3 exports ---

tpolecatScala3Dev: P.ScalaModule = mkBaseMain("3", "dev")
tpolecatScala3Ci: P.ScalaModule = mkBaseMain("3", "ci")
tpolecatScala3: P.ScalaModule = if (read?("env:CI") != null) tpolecatScala3Ci else tpolecatScala3Dev

tpolecatScala3TestDev: P.ScalaTestModule = mkBaseTest("3", "dev")
tpolecatScala3TestCi: P.ScalaTestModule = mkBaseTest("3", "ci")
tpolecatScala3Test: P.ScalaTestModule =
  if (read?("env:CI") != null) tpolecatScala3TestCi else tpolecatScala3TestDev

tpolecatScala3JsDev: P.ScalaJsModule = mkBaseJs("3", "dev")
tpolecatScala3JsCi: P.ScalaJsModule = mkBaseJs("3", "ci")
tpolecatScala3Js: P.ScalaJsModule =
  if (read?("env:CI") != null) tpolecatScala3JsCi else tpolecatScala3JsDev

tpolecatScala3JsTestDev: P.ScalaJsTestModule = mkBaseJsTest("3", "dev")
tpolecatScala3JsTestCi: P.ScalaJsTestModule = mkBaseJsTest("3", "ci")
tpolecatScala3JsTest: P.ScalaJsTestModule =
  if (read?("env:CI") != null) tpolecatScala3JsTestCi else tpolecatScala3JsTestDev

tpolecatScala3NativeDev: P.ScalaNativeModule = mkBaseNative("3", "dev")
tpolecatScala3NativeCi: P.ScalaNativeModule = mkBaseNative("3", "ci")
tpolecatScala3Native: P.ScalaNativeModule =
  if (read?("env:CI") != null) tpolecatScala3NativeCi else tpolecatScala3NativeDev

tpolecatScala3NativeTestDev: P.ScalaNativeTestModule = mkBaseNativeTest("3", "dev")
tpolecatScala3NativeTestCi: P.ScalaNativeTestModule = mkBaseNativeTest("3", "ci")
tpolecatScala3NativeTest: P.ScalaNativeTestModule =
  if (read?("env:CI") != null) tpolecatScala3NativeTestCi else tpolecatScala3NativeTestDev


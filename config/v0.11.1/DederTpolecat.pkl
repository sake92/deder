  if (read?("env:CI") != null) tpolecatScala212Ci else tpolecatScala212Dev

tpolecatScala212TestDev: P.ScalaTestModule = mkBaseTest("2.12", "dev")
tpolecatScala212TestCi: P.ScalaTestModule = mkBaseTest("2.12", "ci")
tpolecatScala212Test: P.ScalaTestModule =
  if (read?("env:CI") != null) tpolecatScala212TestCi else tpolecatScala212TestDev


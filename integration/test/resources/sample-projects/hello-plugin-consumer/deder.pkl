//amends "../../../../../config/DederProject.pkl"

amends "https://sake92.github.io/deder/config/early-access/DederProject.pkl"

import "../hello-plugin/resources/HelloPluginModule.pkl" as HPM

// Shared local Maven repository (set by run-it-tests.sh via DEDER_TMP_M2_REPO env var)
repositories {
  new MavenRepository { url = "file://\(read("env:DEDER_TMP_M2_REPO"))" }
}

plugins {
  new HPM.HelloPlugin {
    config = new HPM.HelloPluginConfig {
      greeting = "Hello from typed config!"
    }
  }
}

modules {
  new ScalaModule {
    id = "app"
    root = "."
    scalaVersion = "3.7.4"
    mainClass = "Main"
  }
}

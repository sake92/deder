amends "modulepath:/ba/sake/deder/config/DederProject.pkl"

// __HELLO_CONFIG_IMPORT__ is injected by the test to import the typed plugin config class
__HELLO_CONFIG_IMPORT__

// Shared local Maven repository (set by run-it-tests.sh via DEDER_TMP_M2_REPO env var)
repositories {
  new MavenRepository { url = "file://\(read("env:DEDER_TMP_M2_REPO"))" }
}

plugins {
  new hc.HelloConfig {
    greeting = "Hello from typed config!"
  }
}

modules {
  new ScalaModule {
    id = "app"
    root = "."
    scalaVersion = "3.7.4"
    mainClass = "Main"
  }
}

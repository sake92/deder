amends "https://sake92.github.io/deder/config/early-access/DederProject.pkl"

import "https://sake92.github.io/deder-plugins/config/deder-web-dashboard/v0.4.0/WebDashboardPlugin.pkl" as WD

plugins {
  new WD.WebDashboardPlugin {
    version = "0.6.0"
    config {
      enabled = false
    }
  }
}

// Keep Scala on the LTS line; do not upgrade to a non-LTS release.
local const scalaVer = "3.9.0"

local const versions = new {
  avajeJsonb = "3.16"
  bouncyCastle = "1.86"
  bsp4j = "2.2.0-M2"
  classgraph = "4.8.199"
  commonsCodec = "1.23.0"
  coursierDependency = "0.3.3"
  coursierInterface = "1.0.30"
  fansi = "0.5.1"
  jarjarAbrams = "1.18.1"
  jgrapht = "1.5.3"
  logback = "1.6.6"
  mainargs = "0.7.8"
  maven = "3.10.0"
  methanol = "1.9.0"
  munit = "1.3.6"
  openTelemetry = "1.67.0"
  osLib = "0.11.10"
  ox = "1.1.0"
  pkl = "0.32.2"
  scaffeine = "5.3.0"
  scalaJs = "1.22.0"
  scalaJsNodejs = "1.6.0"
  scalaLogging = "3.9.6"
  scalaNative = "0.5.12"
  testInterface = "1.0"
  tupson = "0.31.0"
  zinc = "1.13.0"
}

local const function pom(artId: String, artName: String): PomSettings = new {
  groupId = "ba.sake"
  artifactId = artId
  version = read?("env:VERSION")
  name = artName
  description = name
  url = "https://github.com/sake92/deder"
  licenses {
    new PomLicense {
      name = "Apache 2.0 License"
      url = "https://opensource.org/license/apache-2.0"
    }
  }
  developers {
    new PomDeveloper {
      id = "sake92"
      name = "Sakib Hadžiavdić"
      email = "sake92@sake.ba"
    }
  }
  scm {
    url = "https://github.com/sake92/deder"
    connection = "scm:git:git@github.com:sake92/deder.git"
  }
}

local const config = new JavaModule {
  id = "config"
  deps {
    "org.pkl-lang:pkl-config-java:\(versions.pkl)"
  }
  pomSettings = pom("deder-config", "Deder config")
  publish = true
  publishLocalTo = read?("env:DEDER_TMP_M2_REPO")
}

local const dederCommonModules =
  new CreateScalaModules {
    root = "deder-common"
    template = new {
      scalaVersion = scalaVer
      publish = true
      publishLocalTo = read?("env:DEDER_TMP_M2_REPO")
      pomSettings = pom("deder-common", "Deder common")
      deps {
        "ba.sake::tupson:\(versions.tupson)"
        "com.lihaoyi::os-lib:\(versions.osLib)"
        "org.scala-sbt:test-interface:\(versions.testInterface)"
        "com.lihaoyi::fansi:\(versions.fansi)"
        "commons-codec:commons-codec:\(versions.commonsCodec)"
      }
    }
    testTemplate = (template.asTest()) {
      deps {
        "org.scalameta::munit:\(versions.munit)"
      }
      junitXmlReport {
        enabled = true
      }
    }
  }.get

local const testRunner = new ScalaModule {
  id = "test-runner"
  scalaVersion = scalaVer
  publish = false
  moduleDeps { dederCommonModules.main }
  mainClass = "ba.sake.deder.testing.forked.ForkedTestMain"
  shadeRulesFile = "shade.rules"
}

local const pluginApi = new ScalaModule {
  id = "plugin-api"
  root = "plugin-api"
  scalaVersion = scalaVer
  moduleDeps { config; dederCommonModules.main }
  pomSettings = pom("deder-plugin-api", "Deder plugin API")
  publish = true
  publishLocalTo = read?("env:DEDER_TMP_M2_REPO")
  deps {
    "ba.sake::tupson:\(versions.tupson)"
    "com.lihaoyi::os-lib:\(versions.osLib)"
    "com.typesafe.scala-logging::scala-logging:\(versions.scalaLogging)"
    "ch.qos.logback:logback-classic:\(versions.logback)"
    "io.get-coursier::dependency:\(versions.coursierDependency)"
    "io.get-coursier::dependency-interface:\(versions.coursierDependency)"
    "io.opentelemetry:opentelemetry-api:\(versions.openTelemetry)"
  }
}

local const serverModules =
  new CreateScalaModules {
    root = "server"
    template = new ScalaModule {
      scalaVersion = scalaVer
      publish = false
      moduleDeps { config; dederCommonModules.main; pluginApi }
      mainClass = "ba.sake.deder.ServerMain"
      scalacOptions {
        "-Yretain-trees"
      }
      manifest {
        mainAttributes {
          ["Multi-Release"] = "true"
        }
      }
      pomSettings = pom("deder-server", "Deder server")
      deps {
        "com.softwaremill.ox::core:\(versions.ox)"
        "org.jgrapht:jgrapht-core:\(versions.jgrapht)"
        "org.jgrapht:jgrapht-io:\(versions.jgrapht)"
        "com.lihaoyi::os-lib-watch:\(versions.osLib)"
        "commons-codec:commons-codec:\(versions.commonsCodec)"
        "org.scala-sbt:zinc_2.13:\(versions.zinc)"
        "org.scala-sbt:compiler-interface:\(versions.zinc)"
        "io.get-coursier::dependency:\(versions.coursierDependency)"
        "io.get-coursier::dependency-interface:\(versions.coursierDependency)"
        "io.get-coursier:interface:\(versions.coursierInterface)"
        "com.lihaoyi::mainargs:\(versions.mainargs)"
        "io.github.classgraph:classgraph:\(versions.classgraph)"
        "ch.epfl.scala:bsp4j:\(versions.bsp4j)"
        "com.github.blemale::scaffeine:\(versions.scaffeine)"
        "com.eed3si9n.jarjarabrams::jarjar-abrams-core:\(versions.jarjarAbrams)"
        // Keep the linker on Scala 2.13: the Scala 3 artifacts pull their own
        // Scala 3 standard library onto Deder's compiler classpath.
        "org.scala-js:scalajs-linker_2.13:\(versions.scalaJs)"
        "org.scala-js:scalajs-sbt-test-adapter_2.13:\(versions.scalaJs)"
        "org.scala-js:scalajs-env-nodejs_2.13:\(versions.scalaJsNodejs)"
        "org.scala-native::tools:\(versions.scalaNative)"
        "org.scala-native::test-runner:\(versions.scalaNative)"
        "org.apache.maven:maven-model:\(versions.maven)"
        "org.bouncycastle:bcpg-jdk18on:\(versions.bouncyCastle)"
        "org.bouncycastle:bcpkix-jdk18on:\(versions.bouncyCastle)"
        "com.github.mizosoft.methanol:methanol:\(versions.methanol)"
      }
    }
    testTemplate = (template.asTest()) {
      // Suites mutate JVM-wide state (for example DEDER_PROJECT_ROOT_DIR).
      // Keep suites serial within a fork; separate JVM forks can still run in parallel.
      testParallelism = 1
      deps {
        "org.scalameta::munit:\(versions.munit)"
        "io.opentelemetry:opentelemetry-sdk:\(versions.openTelemetry)"
        "io.opentelemetry:opentelemetry-sdk-metrics:\(versions.openTelemetry)"
      }
      junitXmlReport {
        enabled = true
      }
    }
  }.get

local const client = new JavaModule {
  id = "client"
  publish = false
  mainClass = "ba.sake.deder.client.Main"
  pomSettings = pom("deder-client", "Deder client")
  deps {
    "io.avaje:avaje-jsonb:\(versions.avajeJsonb)"
  }
  javacAnnotationProcessorDeps {
    "io.avaje:avaje-jsonb-generator:\(versions.avajeJsonb)"
  }
  graalvm {
    nativeImageOptions {
      "-H:+UnlockExperimentalVMOptions"
      "--no-fallback"
      "-H:+StaticExecutableWithDynamicLibC"
    }
  }
}

local const integrationTestSupport = new ScalaModule {
  id = "integration-test-support"
  root = "integration/test-support"
  scalaVersion = scalaVer
  publish = false
  moduleDeps { serverModules.main }
  deps {
    "org.scalameta::munit:\(versions.munit)"
  }
}

local const function integrationTestModule(moduleId: String, moduleRoot: String): ScalaTestModule = new {
  id = moduleId
  root = moduleRoot
  scalaVersion = scalaVer
  moduleDeps { serverModules.main; integrationTestSupport }
  deps {
    "org.scalameta::munit:\(versions.munit)"
  }
  forkEnv {
    ["DEDER_TMP_M2_REPO"] = read?("env:DEDER_TMP_M2_REPO") ?? "./tmp/m2"
    ["DEDER_PLUGIN_API_VERSION"] = "it-test-version"
  }
  junitXmlReport {
    enabled = true
  }
}

local const jvmIntegrationTest = integrationTestModule("jvm-integration-test", "integration/jvm-test")
local const scalaJsIntegrationTest = integrationTestModule("scalajs-integration-test", "integration/scalajs-test")
local const scalaNativeIntegrationTest = integrationTestModule(
  "scalanative-integration-test",
  "integration/scalanative-test"
)

local const bspIntegrationTest = new ScalaTestModule {
  id = "bsp-integration-test"
  root = "integration/bsp-test"
  scalaVersion = scalaVer
  publish = false
  moduleDeps { serverModules.main; integrationTestSupport }
  deps {
    "org.scalameta::munit:\(versions.munit)"
  }
  // BSP suites start real servers and use Unix sockets, so keep them isolated.
  maxTestForks = 1
  testParallelism = 1
  junitXmlReport {
    enabled = true
  }
}

modules {
  config
  pluginApi
  ...dederCommonModules.all
  testRunner
  ...serverModules.all
  client
  integrationTestSupport
  jvmIntegrationTest
  scalaJsIntegrationTest
  scalaNativeIntegrationTest
  bspIntegrationTest
}

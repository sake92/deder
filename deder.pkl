amends "https://sake92.github.io/deder/config/v0.12.0/DederProject.pkl"

//amends "https://sake92.github.io/deder/config/early-access/DederProject.pkl"

local const scalaVer = "3.7.4"

local const versions = new {
  osLib = "0.11.6"
  tupson = "0.20.0"
  commonsCodec = "1.20.0"
  scalaLogging = "3.9.5"
}

local const sonatypeRepo = new SonatypeCentralRepo {
  id = "sonatype"
}

local const function pom(artId: String, artName: String) = new PomSettings {
  groupId = "ba.sake"
  artifactId = artId
  version = read?("env:VERSION")
  name = artName
  description = name
  url = "https://github.com/sake92/deder"
  licenses {
    new PomLicense {
      name = "Apache 2.0 License"
      url = "https://opensource.org/license/apache-2.0"
    }
  }
  developers {
    new PomDeveloper {
      id = "sake92"
      name = "Sakib Hadžiavdić"
      email = "sake92@sake.ba"
    }
  }
  scm {
    url = "git@github.com:sake92/deder.git"
  }
}

local const config = new JavaModule {
  id = "config"
  deps {
    "org.pkl-lang:pkl-config-java:0.30.2"
  }
  pomSettings = pom("deder-config", "Deder config")
  publish = true
  publishTo = sonatypeRepo
  publishLocalTo = read?("env:DEDER_TMP_M2_REPO")
}

local const testCommonModules =
  new CreateScalaModules {
    root = "test-common"
    template = new {
      scalaVersion = scalaVer
      publish = false
      deps {
        "ba.sake::tupson:\(versions.tupson)"
        "com.lihaoyi::os-lib:\(versions.osLib)"
        "org.scala-sbt:test-interface:1.0"
        "com.lihaoyi::fansi:0.5.1"
      }
    }
    testTemplate = (template.asTest()) {
      deps {
        "org.scalameta::munit:1.2.1"
      }
      junitXmlReport {
        enabled = true
      }
    }
  }.get

local const testRunner = new ScalaModule {
  id = "test-runner"
  scalaVersion = scalaVer
  publish = false
  moduleDeps { testCommonModules.main }
  mainClass = "ba.sake.deder.testing.forked.ForkedTestMain"
  shadeRulesFile = "shade.rules"
}

local const pluginApi = new ScalaModule {
  id = "plugin-api"
  root = "plugin-api"
  scalaVersion = scalaVer
  moduleDeps { config }
  pomSettings = pom("deder-plugin-api", "Deder plugin API")
  publish = true
  publishTo = sonatypeRepo
  publishLocalTo = read?("env:DEDER_TMP_M2_REPO")
  deps {
    "ba.sake::tupson:\(versions.tupson)"
    "com.lihaoyi::os-lib:\(versions.osLib)"
    "commons-codec:commons-codec:\(versions.commonsCodec)"
    "com.typesafe.scala-logging::scala-logging:\(versions.scalaLogging)"
    "ch.qos.logback:logback-classic:1.5.23"
    "io.get-coursier::dependency:0.3.2"
    "io.get-coursier::dependency-interface:0.3.2"
    "io.opentelemetry:opentelemetry-api:1.58.0"
  }
}

local const serverModules =
  new CreateScalaModules {
    root = "server"
    template = new ScalaModule {
      scalaVersion = scalaVer
      publish = false
      moduleDeps { config; testCommonModules.main; pluginApi }
      mainClass = "ba.sake.deder.ServerMain"
      scalacOptions {
        "-Yretain-trees"
      }
      manifest {
        mainAttributes {
          ["Multi-Release"] = "true"
        }
      }
      pomSettings = pom("deder-server", "Deder server")
      deps {
        "com.softwaremill.ox::core:1.0.4"
        "org.jgrapht:jgrapht-core:1.5.2"
        "org.jgrapht:jgrapht-io:1.5.2"
        "com.lihaoyi::os-lib-watch:\(versions.osLib)"
        "commons-codec:commons-codec:\(versions.commonsCodec)"
        "org.scala-sbt:zinc_2.13:1.11.0"
        "org.scala-sbt:compiler-interface:1.11.0"
        "io.get-coursier::dependency:0.3.2"
        "io.get-coursier::dependency-interface:0.3.2"
        "io.get-coursier:interface:1.0.25"
        "com.lihaoyi::mainargs:0.7.8"
        "io.github.classgraph:classgraph:4.8.184"
        "ch.epfl.scala:bsp4j:2.2.0-M2"
        "com.github.blemale::scaffeine:5.3.0"
        "com.eed3si9n.jarjarabrams::jarjar-abrams-core:1.16.0"
        // withDottyCompat → _2.13 artifacts
        "org.scala-js:scalajs-linker_2.13:1.20.2"
        "org.scala-js:scalajs-sbt-test-adapter_2.13:1.20.2"
        "org.scala-js:scalajs-env-nodejs_2.13:1.5.0"
        "org.scala-native::tools:0.5.10"
        "org.scala-native::test-runner:0.5.10"
        "org.apache.maven:maven-model:3.9.12"
        "org.bouncycastle:bcpg-jdk18on:1.78"
        "org.bouncycastle:bcpkix-jdk18on:1.78"
        "com.github.mizosoft.methanol:methanol:1.9.0"
      }
    }
    testTemplate = (template.asTest()) {
      deps {
        "org.scalameta::munit:1.2.1"
        "io.opentelemetry:opentelemetry-sdk:1.58.0"
        "io.opentelemetry:opentelemetry-sdk-metrics:1.58.0"
      }
      junitXmlReport {
        enabled = true
      }
    }
  }.get

local const client = new JavaModule {
  id = "client"
  publish = false
  mainClass = "ba.sake.deder.client.Main"
  pomSettings = pom("deder-client", "Deder client")
  deps {
    "io.avaje:avaje-jsonb:3.13"
  }
  javacAnnotationProcessorDeps {
    "io.avaje:avaje-jsonb-generator:3.13"
  }
  graalvm {
    nativeImageOptions {
      "-H:+UnlockExperimentalVMOptions"
      "--no-fallback"
      "-H:+StaticExecutableWithDynamicLibC"
    }
  }
}

local const integrationTest = new ScalaTestModule {
  id = "integration-test"
  root = "integration/test"
  scalaVersion = scalaVer
  moduleDeps { serverModules.main }
  deps {
    "org.scalameta::munit:1.2.1"
  }
  junitXmlReport {
    enabled = true
  }
  forkEnv {
    ["DEDER_PLUGIN_API_VERSION"] = "it-test-version"
  }
}

modules {
  config
  pluginApi
  ...testCommonModules.all
  testRunner
  ...serverModules.all
  client
  integrationTest
}
